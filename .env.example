# JVM Memory Tuning Flags for 512MB RAM constraints
JAVA_TOOL_OPTIONS="-Xmx320m -Xms200m -XX:MaxMetaspaceSize=96m -XX:+UseG1GC"

# Server Port
PORT=8080

# PostgreSQL Connection Properties
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticket_engine
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Connection Properties (Supports rediss:// for Upstash)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
